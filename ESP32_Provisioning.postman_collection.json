{
	"info": {
		"_postman_id": "esp32-provisioning-collection",
		"name": "ESP32 Provisioning Endpoints",
		"description": "Collection for ESP32 device provisioning and backend certificate signing endpoints.\n\n**CORS Support:** All ESP32 endpoints include CORS headers to allow direct browser-to-device communication:\n- `Access-Control-Allow-Origin: *`\n- `Access-Control-Allow-Methods: GET, POST, OPTIONS`\n- `Access-Control-Allow-Headers: Content-Type, Authorization`\n- `Access-Control-Max-Age: 3600`\n\n**Preflight Requests:** All endpoints support OPTIONS method for CORS preflight requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Device Provisioning (ESP32)",
			"item": [
				{
					"name": "Scan WiFi Networks",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://192.168.4.1/local-wifi",
							"protocol": "http",
							"host": [
								"192.168.4.1"
							],
							"path": [
								"local-wifi"
							],
							"query": [
								{
									"key": "refresh",
									"value": "false",
									"description": "Set to true to force a new scan (may disrupt connection)"
								}
							]
						},
						"description": "Scans for available WiFi networks. Returns cached results instantly for better UX.\n\n**CORS:** This endpoint includes CORS headers and supports OPTIONS preflight requests."
					},
					"response": [
						{
							"name": "Success - WiFi Networks",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "http://192.168.4.1/local-wifi",
									"protocol": "http",
									"host": [
										"192.168.4.1"
									],
									"path": [
										"local-wifi"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"networks\": [\n    {\n      \"ssid\": \"Statsnapp\",\n      \"rssi\": -45,\n      \"channel\": 6,\n      \"secure\": true\n    },\n    {\n      \"ssid\": \"MyHomeWiFi\",\n      \"rssi\": -67,\n      \"channel\": 11,\n      \"secure\": true\n    },\n    {\n      \"ssid\": \"GuestNetwork\",\n      \"rssi\": -78,\n      \"channel\": 1,\n      \"secure\": false\n    }\n  ],\n  \"count\": 3,\n  \"cached\": true\n}"
						}
					]
				},
