# OTA dual-partition layout (current firmware ~1MB; 2MB flash is too small for dual OTA)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Presigned S3 download URLs use public CA bundle (no device mTLS)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Broker + backend (matches Node mtlsclient reference)
CONFIG_BACKEND_URL="https://server.withproof.io"
CONFIG_MQTT_BROKER_URI="mqtts://broker.withproof.io:8883"
CONFIG_MQTT_TOPIC_ROOT="proof.mqtt"
CONFIG_USE_EMBEDDED_MTLS_CERTS=y
CONFIG_MTLS_CLIENT_DEVICE_ID="DEVICE-17"
CONFIG_MQTT_SUBSCRIBE_ALL=y
CONFIG_DEV_WIFI_SSID="Statsnapp"
CONFIG_DEV_WIFI_PASSWORD="1q2w3e4r"
