# OTA dual-partition layout (current firmware ~1MB; 2MB flash is too small for dual OTA)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Presigned OCI/S3 download URLs use public CA bundle (no device mTLS)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Broker + backend (production broker — DEVICE-15 mTLS certs from certs/)
CONFIG_BACKEND_URL="https://server.withproof.io"
CONFIG_MQTT_BROKER_URI="mqtts://broker.withproof.io:8883"
CONFIG_MQTT_TOPIC_ROOT="proof.mqtt"
CONFIG_USE_EMBEDDED_MTLS_CERTS=y
CONFIG_MTLS_CLIENT_DEVICE_ID="DEVICE-15"
CONFIG_MQTT_SUBSCRIBE_ALL=y
CONFIG_DEV_WIFI_SSID="OPPO F31 Pro+ 5G A674"
CONFIG_DEV_WIFI_PASSWORD="ncbx8825"

CONFIG_ENABLE_DWIN_DISPLAY=y
# CONFIG_ESP_BROWNOUT_DET is not set
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=44
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set

# OTA E2E baseline version (bump to 4.3.1-mvp for target build)
CONFIG_FIRMWARE_VERSION="4.3.0-mvp"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="4.3.0-mvp"
CONFIG_OTA_ED25519_PUBLIC_KEY_HEX="8ab0959d4ad944b51894e5b4dfaf6cd4b8f51680cc413bb77d3156167c6a746e"
